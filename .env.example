# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode Compose service does not load these. Do not add
# QBO_ACCESS_TOKEN, QBO_REALM_ID, or QBO_ENV to that service's environment
# or via env_file.
QBO_ACCESS_TOKEN=
QBO_REALM_ID=
# QBO_ENV=production

# Optional dotenv file re-read on every request (env mode). Not used by the
# gateway Compose service.
# QBO_CREDENTIALS_FILE=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Required to start the HTTP transport. Leave this empty here.
# Generate a value with: openssl rand -hex 32
# The process exits if this is empty or a known placeholder (changeme,
# your-s2s-secret, secret, placeholder, and similar public examples), so a
# copied example cannot forge X-Gateway-S2S. Compose will not start when it
# is unset. Never commit a real value. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. Logs a warning, does not enforce X-Gateway-S2S, and
# forces the listener onto 127.0.0.1 even if MCP_HTTP_HOST is 0.0.0.0.
# A known placeholder secret is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when MCP_TRANSPORT=http. Defaults to 127.0.0.1 when unset.
# A configured CONDUIT_S2S_SECRET honors this value. The container image
# sets 0.0.0.0. Without a secret, MCP_ALLOW_INSECURE_DEV=1 binds 127.0.0.1 only.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# gateway: X-Qbo-Access-Token and X-Qbo-Realm-Id on each /mcp request.
#          Docker image and Compose default. Never falls back to QBO_*.
# env:     use QBO_* after X-Gateway-S2S verifies.
# AUTH_MODE=gateway

# LOG_LEVEL=info
# LOG_FORMAT=json
